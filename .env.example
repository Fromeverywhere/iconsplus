# ===== 站点 =====
SITE_NAME=icons+
PORT=5000

# ===== 缩略图（沿用 xg-icons-hub）=====
THUMB_ENABLED=true
THUMB_WATCH=true
THUMB_SCAN_INTERVAL=300

# ===== 管理员（默认 admin / iconsplus）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=iconsplus
# 会话签名密钥：生产务必改成一段长随机串
SESSION_SECRET=please-change-me-to-a-long-random-string

# ===== 防盗链 =====
HOTLINK_ENABLED=true
# 允许外链的白名单（逗号分隔，按 host 后缀匹配，支持子域），同站永远放行
HOTLINK_ALLOWLIST=example.com,localhost
# 空 Referer（直接访问 / 书签）是否放行
HOTLINK_ALLOW_EMPTY_REFERER=true

# ===== 公开提交接口限流（每 IP 每小时上限）=====
SUBMISSION_RATE_LIMIT=20
